# Copier ce fichier en .env.local pour le développement local.
# En production : Vercel → Project Settings → Environment Variables (environnement « Production »).

# --- Formulaire de contact (/api/contact) — REQUIS pour que le formulaire envoie des e-mails ---
# Clé API Resend (https://resend.com/api-keys). Sans elle, l'API répond 503 et le formulaire
# affiche un message invitant à passer par GitHub.
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire.
CONTACT_TO_EMAIL=
# Optionnel. Expéditeur (domaine vérifié dans Resend). Par défaut : Portfolio <onboarding@resend.dev>
# (l'expéditeur de test Resend n'envoie qu'à l'adresse du compte Resend).
CONTACT_FROM_EMAIL=

# --- URL publique (optionnel) ---
# Inutile sur Vercel : VERCEL_PROJECT_PRODUCTION_URL est fournie automatiquement au build.
# À définir uniquement pour un domaine personnalisé. Sans slash final.
# Exemple : https://mahamadou-dembele.fr
NEXT_PUBLIC_SITE_URL=
