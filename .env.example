# Copier ce fichier en .env.local pour le développement local.
# En production, définir ces variables dans Vercel → Project Settings → Environment Variables.

# URL publique du site (canonical, Open Graph, sitemap). Sans slash final.
# Exemple : https://portfolio-dembele.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Formulaire de contact (/api/contact) ---
# Clé API Resend (https://resend.com/api-keys). Sans elle, l'API répond 503
# et le formulaire propose un repli par email.
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire.
CONTACT_TO_EMAIL=
# Expéditeur (domaine vérifié dans Resend). Par défaut : Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# --- Analytics (optionnel) ---
# Vercel Web Analytics s'active depuis le dashboard Vercel, aucune variable requise.
